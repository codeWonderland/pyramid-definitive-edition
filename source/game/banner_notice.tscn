[gd_scene format=3]

[ext_resource type="Script" path="res://source/game/banner_notice.gd" id="1_notice"]

[node name="BannerNotice" type="PanelContainer"]
offset_right = 520.0
offset_bottom = 120.0
theme_type_variation = &"LibraryTile"
script = ExtResource("1_notice")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Text" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="NoticeTitle" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Banner saved"

[node name="NoticeDetail" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
text = "pyramid-run.png in Pictures"

[node name="ShowInFolder" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Show in Folder"
